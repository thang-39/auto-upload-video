    {
      "parameters": {
        "jsCode": "// Re-attach the binary video data lost after the Initiate step\nconst uploadUrl = $input.item.json.headers.location;\nconst binary = $('Read Video File').item.binary;\n\nreturn [{ json: { uploadUrl }, binary }];"
      },
      "id": "b5c6d7e8-f9a0-1234-bcde-f56789012345",
