{
  "name": "Notion → Download Facebook Video (TikTok Manual)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 19 * * *"
            }
          ]
        }
      },
      "id": "723d95c6-2d1c-4d26-857a-6a49139999ff",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        6144,
        2096
      ]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "value": "adf94e9d3b9b42728f114fb1ab554ab5",
          "mode": "id"
        },
        "limit": 1,
        "filterType": "manual",
        "filters": {
          "conditions": [
            {
              "key": "Tiktok_Status|status",
              "condition": "equals",
              "statusValue": "Ready"
            }
          ]
        },
        "options": {}
      },
      "id": "9066e749-f3b9-438d-8403-2e69225a418e",
      "name": "Get Next Ready Video",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        6384,
        2096
      ],
      "credentials": {
        "notionApi": {
          "id": "1x21QAoszbkHoHWL",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-has-items",
              "leftValue": "={{ $items().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6266463a-e972-477d-a4c0-a9825290ea54",
      "name": "Has Videos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        6608,
        2096
      ]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "update",
        "pageId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Tiktok_Status|status",
              "statusValue": "Downloading"
            }
          ]
        },
        "options": {}
      },
      "id": "2eafeb0c-c98b-4f5f-811b-de2d30a2c407",
      "name": "Mark Downloading",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        6832,
        1984
      ],
      "credentials": {
        "notionApi": {
          "id": "1x21QAoszbkHoHWL",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "command": "=yt-dlp --no-playlist --merge-output-format mp4 -o \"/home/node/downloads/{{ $('Get Next Ready Video').item.json.id }}_{{ $('Get Next Ready Video').item.json.property_title }}.%(ext)s\" \"{{ $('Get Next Ready Video').item.json.property_fb_link }}\""
      },
      "id": "b0202f6f-c95a-475c-993a-f123bc02dce0",
      "name": "Download Video",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        7040,
        1984
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-exit-code",
              "leftValue": "={{ $json.exitCode }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ca8b649f-2295-4f49-89ce-b4b7ed6d2ac7",
      "name": "Download OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        7264,
        1984
      ]
    },
    {
      "parameters": {
        "command": "=rm \"{{ $('Find Downloaded File').item.json.stdout.trim() }}\""
      },
      "id": "9483ae9a-750e-47dd-a795-afc32ce18328",
      "name": "Delete Video File",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        9008,
        2176
      ]
    },
    {
      "parameters": {
        "command": "=TOKEN=$(cat /home/node/downloads/tiktok_token.json)\nSIZE=$(stat -c %s \"{{ $('Find Downloaded File').item.json.stdout.trim() }}\")\necho \"{\\\"token\\\": $TOKEN, \\\"size\\\": $SIZE}\""
      },
      "id": "972d03eb-e15b-4d5d-92df-1a0a32433fde",
      "name": "Read TikTok Metadata",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        7936,
        2176
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/oauth/token/",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "client_key",
              "value": "={{ $env.TIKTOK_CLIENT_KEY }}"
            },
            {
              "name": "client_secret",
              "value": "={{ $env.TIKTOK_CLIENT_SECRET }}"
            },
            {
              "name": "grant_type",
              "value": "refresh_token"
            },
            {
              "name": "refresh_token",
              "value": "={{ JSON.parse($json.stdout).token.refresh_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "refresh-tiktok-token",
      "name": "Refresh TikTok Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        7840,
        2176
      ]
    },
    {
      "parameters": {
        "mode": "jsonToBinary",
        "convertAllData": true,
        "destinationDataPropertyName": "data",
        "options": {
          "fileName": "tiktok_token.json"
        }
      },
      "id": "token-to-binary",
      "name": "Token to Binary",
      "type": "n8n-nodes-base.moveBinaryData",
      "typeVersion": 1,
      "position": [
        8040,
        2176
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "/home/node/downloads/tiktok_token.json",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "save-updated-token",
      "name": "Save Updated Token",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        8240,
        2176
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/video/init/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Refresh TikTok Token').item.json.access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json; charset=UTF-8"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ post_info: { title: ($('Get Next Ready Video').item.json.property_title || 'Video Upload').substring(0, 150), privacy_level: 'SELF_ONLY' }, source_info: { source: 'FILE_UPLOAD', video_size: JSON.parse($('Read TikTok Metadata').item.json.stdout).size, chunk_size: JSON.parse($('Read TikTok Metadata').item.json.stdout).size, total_chunk_count: 1 } }) }}",
        "options": {}
      },
      "id": "3cd1826d-ef94-43b6-a521-1e5029f35e36",
      "name": "TikTok Init Manual",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        8448,
        2176
      ]
    },
    {
      "parameters": {
        "jsCode": "// Re-attach the binary video data lost after the TikTok Init step\nconst data = $input.item.json.data;\nconst binary = $('Read Video File').item.binary;\n\nreturn [{ json: { data }, binary }];"
      },
      "id": "c519fdab-bb7c-471e-a3b7-c7eda0143d59",
      "name": "Prepare TikTok Upload Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8304,
        2176
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $json.data.upload_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "video/mp4"
            },
            {
              "name": "Content-Range",
              "value": "={{ 'bytes 0-' + (JSON.parse($('Read TikTok Metadata').item.json.stdout).size - 1) + '/' + JSON.parse($('Read TikTok Metadata').item.json.stdout).size }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {}
      },
      "id": "4d286a80-1ce0-446a-8c52-17d225b90cfe",
      "name": "TikTok Upload Manual",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        8496,
        2176
      ]
    },
    {
      "parameters": {
        "resource": "databasePage",
